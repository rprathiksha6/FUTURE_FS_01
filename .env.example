# Copy this file to .env and fill in your own EmailJS values.
# Get these from https://www.emailjs.com/ after creating a free account,
# an email service, and an email template.
#
# All three are required for the contact form to actually send emails.
# Vite only exposes variables prefixed with VITE_ to the browser, so the
# prefix below is required, not optional.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
